[Unit]
Description=Lückenfüller firewall: the server container may only reach the public internet
Documentation=https://github.com/Dr-Nerdlove/gapfinder/blob/main/docs/server-setup.md
# Loaded before Docker starts and before the network comes up, so no container ever runs unprotected.
# Never enable Debian's nftables.service: its default configuration flushes the whole ruleset, including
# the rules Docker has added. This unit only loads and removes its own table "lueckenfueller".
# Same ordering as Debian's own nftables.service: early in boot, without the default dependencies.
DefaultDependencies=no
Wants=network-pre.target
Before=docker.service network-pre.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/lueckenfueller/firewall.nft
ExecStop=/usr/sbin/nft delete table inet lueckenfueller

[Install]
WantedBy=multi-user.target
