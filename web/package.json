{
  "name": "@lueckenfueller/web",
  "private": true,
  "version": "2.3.0",
  "type": "module",
  "scripts": {
    "predev": "npm run build -w shared",
    "dev": "vite",
    "build": "vite build && vite build -c vite.sw.config.ts",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.sw.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@capacitor/core": "8.5.0",
    "@lueckenfueller/shared": "*",
    "@material/material-color-utilities": "^0.4.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
