# Copy to ".env" next to compose.yaml and adjust. Never commit ".env" (it is ignored by git).

# Address the app is served from, exactly as the browser shows it: scheme + host (+ port), no path,
# no trailing slash. Several origins are separated by commas.
# For GitHub Pages this is https://<github-user>.github.io (without /gapfinder).
CORS_ORIGIN=https://dr-nerdlove.github.io

# Address of the web app including its path, used for the invite and password links the command line tool
# prints. The published server image already knows it (set when CI builds it), so leave this commented out;
# it only matters when you run the server yourself, e.g. APP_URL=https://dr-nerdlove.github.io/gapfinder/
# APP_URL=http://localhost:5173/

# Key that encrypts the calendar subscription links stored in the database (32 random bytes, base64).
# On the server VM, setup.sh creates it in /opt/lueckenfueller/.env and the nightly backups carry it
# (encrypted), so a restore brings it back. To run locally, create one with:
#   head -c 32 /dev/urandom | base64
# Never commit it, and do not change it later: the stored links could no longer be read.
# Without it the calendar features are switched off.
# CALENDAR_KEY=

# Firebase service-account key for instant notifications in the Android app (the "doorbell": the server tells
# Google only that a phone should look for news, never what about). It is the key file from the Firebase
# console (Project settings > Service accounts > Generate new private key), as one base64 line:
#   base64 -w0 firebase-key.json
# On the server VM, setup.sh asks for the file, writes this line into /opt/lueckenfueller/.env and deletes the file.
# The key is NOT in the nightly backups (only in .env); after a rebuild, make a new key in Firebase.
# Without it (or with a bad one) the server runs normally; the app then only checks every 15 minutes.
# FCM_SERVICE_ACCOUNT=

# Port and interface inside the container. Normally leave these alone.
# PORT=8080
# HOST=0.0.0.0

# Where the SQLite database lives. The Docker image uses /data (mounted from ./data).
# DATA_DIR=/data

# Only set to "true" when a proxy you control sits in front of the server and sets X-Forwarded-* headers.
# TRUST_PROXY=false

# Version shown by /api/health. The published image already contains its own version.
# APP_VERSION=dev

# Log level: fatal, error, warn, info, debug, trace or silent.
# LOG_LEVEL=info
